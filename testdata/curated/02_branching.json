    { "id": "source-middle", "sources": ["source"], "targets": ["middle"] },
    { "id": "source-right", "sources": ["source"], "targets": ["right"] },
    { "id": "left-sink", "sources": ["left"], "targets": ["sink"] },
    { "id": "middle-sink", "sources": ["middle"], "targets": ["sink"] },
